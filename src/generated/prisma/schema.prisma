// FUELRUSH — Complete Database Schema
// Prisma 7.10 | PostgreSQL 16
// All tables have RLS enabled via raw SQL migrations

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  customer
  driver
  admin
  super_admin
}

enum OrderStatus {
  pending
  confirmed
  driver_assigned
  driver_en_route
  arrived
  fueling
  completed
  cancelled
  failed
}

enum FuelType {
  petrol
  diesel
  cng
  ev_charge
}

enum PaymentStatus {
  pending
  processing
  success
  failed
  refunded
  partially_refunded
}

enum PaymentMethod {
  wallet
  stripe
  razorpay
  upi
  cash
}

enum TransactionType {
  credit
  debit
  refund
  bonus
  penalty
}

enum NotificationPriority {
  low
  normal
  high
  critical
}

enum AuditAction {
  create
  update
  delete
  login
  logout
  payment
  refund
  price_change
  role_change
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  phone             String    @unique
  email             String?   @unique
  name              String?
  avatarUrl         String?
  role              UserRole  @default(customer)
  isVerified        Boolean   @default(false)
  isActive          Boolean   @default(true)
  isSuspended       Boolean   @default(false)
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String? // TOTP secret (encrypted)
  pinHash           String? // bcrypt hashed PIN
  biometricEnabled  Boolean   @default(false)
  deviceFingerprint String?
  lastLoginAt       DateTime?
  suspendedUntil    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Encrypted PII fields (AES-256-GCM)
  encryptedPhone String?
  encryptedEmail String?
  encryptedName  String?

  // Relations
  sessions      Session[]
  addresses     Address[]
  vehicles      Vehicle[]
  orders        Order[]
  wallet        Wallet?
  transactions  WalletTransaction[]
  notifications Notification[]
  auditLogs     AuditLog[]
  driverProfile DriverProfile?
  supportChats  SupportChat[]

  @@index([phone])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ─────────────────────────────────────────────
// SESSIONS
// ─────────────────────────────────────────────

model Session {
  id                String   @id @default(uuid())
  userId            String
  refreshToken      String   @unique
  deviceFingerprint String?
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  isRevoked         Boolean  @default(false)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// ADDRESSES
// ─────────────────────────────────────────────

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String // "Home", "Office", etc.
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  latitude  Float
  longitude Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────
// VEHICLES
// ─────────────────────────────────────────────

model Vehicle {
  id                 String   @id @default(uuid())
  userId             String
  registrationNumber String   @unique
  make               String
  model              String
  year               Int?
  fuelType           FuelType
  tankCapacityLiters Float?
  color              String?
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("vehicles")
}

// ─────────────────────────────────────────────
// DRIVER PROFILES
// ─────────────────────────────────────────────

model DriverProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  licenseNumber        String   @unique
  licenseExpiry        DateTime
  vehicleType          String // "tanker_small", "tanker_large"
  tankerCapacityLiters Float
  currentLatitude      Float?
  currentLongitude     Float?
  isAvailable          Boolean  @default(true)
  isOnDelivery         Boolean  @default(false)
  rating               Float    @default(5.0)
  totalDeliveries      Int      @default(0)
  kycVerified          Boolean  @default(false)
  kycDocuments         Json? // Encrypted references
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([isAvailable])
  @@index([currentLatitude, currentLongitude])
  @@map("driver_profiles")
}

// ─────────────────────────────────────────────
// FUEL RATES
// ─────────────────────────────────────────────

model FuelRate {
  id            String    @id @default(uuid())
  fuelType      FuelType
  pricePerLiter Float
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  region        String    @default("default")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@unique([fuelType, effectiveFrom, region])
  @@index([fuelType, isActive])
  @@map("fuel_rates")
}

// ─────────────────────────────────────────────
// PRICING SNAPSHOTS
// ─────────────────────────────────────────────

model PricingSnapshot {
  id              String   @id @default(uuid())
  orderId         String?  @unique
  fuelType        FuelType
  basePrice       Float
  surgeMultiplier Float    @default(1.0)
  deliveryFee     Float
  taxAmount       Float
  discountAmount  Float    @default(0)
  totalAmount     Float
  quantityLiters  Float
  priceLockedAt   DateTime @default(now())
  priceExpiresAt  DateTime
  createdAt       DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id])

  @@index([priceExpiresAt])
  @@map("pricing_snapshots")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id               String      @id @default(uuid())
  userId           String
  driverId         String?
  addressId        String
  vehicleId        String?
  fuelType         FuelType
  quantityLiters   Float
  status           OrderStatus @default(pending)
  subtotal         Float
  deliveryFee      Float
  taxAmount        Float
  discountAmount   Float       @default(0)
  totalAmount      Float
  promoCode        String?
  notes            String?
  estimatedArrival DateTime?
  actualArrival    DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  driver          DriverProfile?   @relation(fields: [driverId], references: [id])
  address         Address          @relation(fields: [addressId], references: [id])
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id])
  pricingSnapshot PricingSnapshot?
  payments        Payment[]
  trackingEvents  TrackingEvent[]

  @@index([userId, status])
  @@index([driverId, status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

// ─────────────────────────────────────────────
// TRACKING EVENTS
// ─────────────────────────────────────────────

model TrackingEvent {
  id         String   @id @default(uuid())
  orderId    String
  latitude   Float
  longitude  Float
  speed      Float?
  bearing    Float?
  recordedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, recordedAt])
  @@map("tracking_events")
}

// ─────────────────────────────────────────────
// WALLETS
// ─────────────────────────────────────────────

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Float    @default(0)
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

// ─────────────────────────────────────────────
// WALLET TRANSACTIONS (Immutable Ledger)
// ─────────────────────────────────────────────

model WalletTransaction {
  id           String          @id @default(uuid())
  walletId     String
  userId       String
  type         TransactionType
  amount       Float
  balanceAfter Float
  description  String
  referenceId  String? // Order ID, Payment ID, etc.
  metadata     Json?
  createdAt    DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  userId          String
  method          PaymentMethod
  status          PaymentStatus @default(pending)
  amount          Float
  currency        String        @default("INR")
  gatewayTxnId    String?       @unique
  gatewayResponse Json?
  idempotencyKey  String        @unique
  failureReason   String?
  initiatedAt     DateTime      @default(now())
  completedAt     DateTime?
  refundedAt      DateTime?
  refundAmount    Float?

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([userId, status])
  @@index([status, initiatedAt])
  @@map("payments")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id           String               @id @default(uuid())
  userId       String
  title        String
  body         String
  priority     NotificationPriority @default(normal)
  data         Json?
  isRead       Boolean              @default(false)
  readAt       DateTime?
  fcmMessageId String?
  createdAt    DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// SUPPORT CHATS
// ─────────────────────────────────────────────

model SupportChat {
  id        String   @id @default(uuid())
  userId    String
  subject   String
  status    String   @default("open") // open, resolved, closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  messages SupportMessage[]

  @@index([userId, status])
  @@map("support_chats")
}

model SupportMessage {
  id         String   @id @default(uuid())
  chatId     String
  senderId   String? // null for system messages
  content    String
  isFromUser Boolean  @default(true)
  createdAt  DateTime @default(now())

  chat SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("support_messages")
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// PROMO CODES
// ─────────────────────────────────────────────

model PromoCode {
  id             String   @id @default(uuid())
  code           String   @unique
  description    String
  discountType   String // "percentage", "flat"
  discountValue  Float
  minOrderAmount Float    @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usageCount     Int      @default(0)
  validFrom      DateTime
  validUntil     DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([code, isActive])
  @@map("promo_codes")
}

// ─────────────────────────────────────────────
// FUEL RATE HISTORY (for analytics)
// ─────────────────────────────────────────────

model FuelRateHistory {
  id            String   @id @default(uuid())
  fuelType      FuelType
  pricePerLiter Float
  region        String
  recordedAt    DateTime @default(now())

  @@index([fuelType, recordedAt])
  @@map("fuel_rate_history")
}
